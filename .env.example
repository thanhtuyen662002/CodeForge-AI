# Environment classification must be explicit before using hosted services.
CODEFORGE_ENVIRONMENT=unknown
CODEFORGE_SUPABASE_PROJECT_REF=
CODEFORGE_MIGRATION_TARGET_APPROVED=false
CODEFORGE_MIGRATION_AUTHORITY_VERIFIED=false
CODEFORGE_PRODUCTION_RELEASE_APPROVED=false

# Browser-safe Supabase configuration only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase CLI/database authentication is migration authority, not an application API key.
# Keep CLI access tokens and database passwords only in approved local/provider secret storage.
# Never expose privileged values through NEXT_PUBLIC_*.

# Set by/configured for the verified Vercel project, not guessed locally.
VERCEL_PROJECT_ID=
VERCEL_ENV=
